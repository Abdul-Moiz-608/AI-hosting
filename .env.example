APP_NAME=Sevus
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
# Required before creating a server: public URL reachable by the VPS.
PUBLIC_API_BASE_URL=https://YOUR_PUBLIC_API_DOMAIN
PINGGY_SSH_HOST=free.pinggy.io
PINGGY_SSH_PORT=443
PINGGY_TIMEOUT_SECONDS=45
PINGGY_HEALTH_PATH=/api/health
VAULT_MASTER_KEY=PASTE_A_FERNET_KEY_HERE
DATABASE_URL=sqlite:///./data/onboarding.db
# Include every browser origin that serves the dashboard, comma-separated.
CORS_ORIGINS=http://localhost:8000,https://YOUR_PUBLIC_API_DOMAIN
# Optional GitHub token. Without it, metadata uses GitHub's unauthenticated rate limit.
GITHUB_TOKEN=
# Redis connection used by the deployment intake queue. Prefer 127.0.0.1 over
# localhost: localhost resolves to ::1 first on a dual-stack host, which doubles
# how long a refused connection takes to report. Leave empty to force the
# in-memory queue.
REDIS_URL=redis://127.0.0.1:6379/0
# Groq is used only when deterministic repository detection is inconclusive.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ── Part D · Deployment planning ────────────────────────────────
# Absolute path on the target VPS that owns releases and current symlinks.
DEPLOYMENT_BASE_PATH=/opt/sevus
DEPLOYMENT_RELEASE_ROOT=releases
# Host port pool used when assigning a collision-free published port.
DEPLOYMENT_PORT_RANGE_START=30000
DEPLOYMENT_PORT_RANGE_END=30999
# Wildcard domain used to build the reverse proxy hostname per application.
DEPLOYMENT_PROXY_DOMAIN=apps.local
DEPLOYMENT_NETWORK_PREFIX=sevus
DEPLOYMENT_HEALTH_PATH=/
DEPLOYMENT_BUILD_TIMEOUT_SECONDS=900
DEPLOYMENT_HEALTH_TIMEOUT_SECONDS=180
DEPLOYMENT_STEP_TIMEOUT_SECONDS=300
# Artifact generation is template-first; Groq is only used when no template exists.
DEPLOYMENT_ARTIFACT_LLM_ENABLED=true
