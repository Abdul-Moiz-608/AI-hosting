APP_NAME=AI Hosting Platform
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000

# Pinggy Configuration
PINGGY_SSH_HOST=free.pinggy.io
PINGGY_SSH_PORT=443
PINGGY_TIMEOUT_SECONDS=45
PINGGY_HEALTH_PATH=/api/health
# FIX 1: Paste your free Pinggy access token here to prevent connection drops
