# Public API URL (fallback if Pinggy tunnel is disabled)
PUBLIC_API_BASE_URL=https://your_public_api_domain

# Security & DB
VAULT_MASTER_KEY=nSbWQTN0vH9XVc2g4RTa9g2A0jhOjKj0h76cbe7Q7mA=
