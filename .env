# Queue Configuration
# Set your Redis instance connection string here
REDIS_URL=redis://localhost:6379/0

# FIX 2: Added wildcard/Pinggy origins so CORS doesn't block requests
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://*.pinggy.net,https://*.pinggy.link